# Copy to .env.local for local development. Never commit .env.local.

# Supabase project "re-sound.be" (ref toroqgofzsanxcisdbkn) — the catalogue and the orders.
# Server-side only: no NEXT_PUBLIC_ prefix, so the key can never be inlined into a browser bundle
# (src/lib/db/supabase.ts also refuses client imports). The older NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY names are still read as a fallback.
# Without them the site runs on src/data/catalogue.snapshot.json and orders are e-mail-only.
SUPABASE_URL=https://toroqgofzsanxcisdbkn.supabase.co
SUPABASE_ANON_KEY=
# Optional: used instead of the anon key when set (recommended in production, so that
# execute on place_order()/mark_order_mailed() can be revoked from anon). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Order and contact e-mails go through this Power Automate flow (see docs/order-flow.md).
POWER_AUTOMATE_WEBHOOK_URL=
# Where orders are sent; defaults to info@re-sound.be.
ORDER_EMAIL=
